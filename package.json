{
  "name": "spotify-genres-top-50",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n BUILD,PAGES -c yellow,cyan \"bun run dev:build:watch\" \"bun run dev:pages\"",
    "dev:build": "astro build --devOutput",
    "dev:build:watch": "chokidar \"src/**/*\" \"public/**/*\" \"astro.config.mjs\" --initial -c \"bun run dev:build\"",
    "dev:pages": "wrangler pages dev dist --compatibility-date=2026-02-25",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "^5.3.0"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.1.2",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
